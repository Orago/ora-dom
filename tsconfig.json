{
	"compilerOptions": {
		"target": "es6",
		"lib": [
			"es6",
			"DOM",
			"ES2022"
		],
		"types": [],
		"noLib": false,
		"module": "nodenext",
		"rootDir": "./src",
		"moduleResolution": "nodenext",
		"paths": {
			"*": [
				"./node_modules/*"
			]
		},
		"declaration": true,
		"outDir": "./js",
		"preserveConstEnums": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		// "skipLibCheck": true,
	},
	"include": [
		"src",
	]
}