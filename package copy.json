{
	"name": "@orago/dom",
	"version": "0.0.50",
	"description": "Orago's Game library",
	"type": "module",
	"main": "dist/esm/index.js",
	"types": "./dist/types/index.d.ts",
	"scripts": {
		"build": "npm run build:clean && npm run build-types && npm run build-cjs & npm run build-esm & npm run build-browser-esm ",
		"build:clean": "rimraf dist/",
		"build-types": "npx tsc --module nodenext --outDir dist/types/ --declarationDir dist/types/ --emitDeclarationOnly",
		"build-cjs": "npx tsc --module commonjs --moduleResolution node --outDir dist/cjs/ --declarationDir dist/cjs",
		"build-esm": "npx tsc --module nodenext --outDir dist/esm/ --declarationDir dist/esm",
		"build-browser-esm": "rollup --config rollup.config.browser.esm.js --configPlugin typescript --name oradom",
		"bb": "npm run build-browser-umd",
		"test": "echo \"Error: no test specified\" && exit 1"
	},
	"exports": {
		".": {
			"default": {
				"types": "./dist/types/index.d.ts",
				"import": "./dist/esm/index.js",
				"require": "./dist/cjs/index.js"
			}
		},
		"./*": {
			"types": "./dist/types/*.d.ts",
			"import": "./dist/esm/*.js",
			"require": "./dist/cjs/*.js"
		},
		"./jsx-runtime": {
			"types": "./dist/types/jsx.d.ts",
			"import": "./dist/esm/jsx.js",
			"require": "./dist/cjs/jsx.js"
		}
	},
	"author": "Orago",
	"license": "ISC",
	"dependencies": {
		"@orago/lib": "^0.0.46",
		"uuid": "^9.0.1"
	},
	"devDependencies": {
		"@rollup/plugin-node-resolve": "^15.2.3",
		"@rollup/plugin-typescript": "^11.1.6",
		"@types/uuid": "^9.0.8",
		"rollup": "^4.18.1",
		"rollup-plugin-dts": "^6.2.1",
		"typescript": "^5.3.3",
		"vite": "^7.1.7"
	}
}